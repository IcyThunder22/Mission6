@{
}

@model List<Movie>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>LentTo</th>
            <th>CopiedToPlex</th>
            <th>Notes</th>
        </tr>
        
    </thead>
        @foreach (var movie in Model)
        {
        <tbody>
            <tr>
				<td>@movie.Title</td>
				<td>@movie.Categories</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>@movie.Edited</td>
            <td>@movie.LentTo</td>
            <td>CopiedToPlex Filler</td>
            <td>@movie.Notes</td>
            </tr>
        
    </tbody>
    }
</table>
